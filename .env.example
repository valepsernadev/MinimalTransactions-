MSSQL_SA_PASSWORD=      # >= 8 caracteres con mayuscula, minuscula, numero y simbolo; evitar $ y # (dotenv trata # sin comillas como comentario y trunca el valor)
DB_HOST=localhost       # en Docker Compose lo fija el compose a "db"
DB_PORT=1433
DB_NAME=MinimalTx
PORT=3000
STORAGE=sqlserver       # "memory" = sin Docker (tests / salvavidas); no es la configuracion de entrega
